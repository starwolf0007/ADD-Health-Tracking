{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and non-sensitive application preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 120 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["uid"]
    },
    "Task": {
      "title": "Task",
      "description": "Executive task item with optional re-entry note",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 300 },
        "notes": { "type": "string", "maxLength": 4000 },
        "energy": { "type": "string", "enum": ["low", "medium", "high"] },
        "status": {
          "type": "string",
          "enum": ["pending", "inProgress", "completed", "skipped", "paused", "blocked"]
        },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "dueDate": { "type": "string", "format": "date-time", "maxLength": 64 },
        "completedAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "activeStartedAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "estimatedMinutes": { "type": "number" },
        "isQuickWin": { "type": "boolean" },
        "googleTaskId": { "type": "string", "maxLength": 256 },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["id", "title", "energy", "status", "createdAt", "isQuickWin"]
    },
    "Routine": {
      "title": "Routine",
      "description": "Ordered step-by-step routine",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 160 },
        "anchor": { "type": "string", "enum": ["morning", "midday", "evening", "custom"] },
        "scheduleHour": { "type": "number" },
        "scheduleMinute": { "type": "number" },
        "isActive": { "type": "boolean" },
        "activeDays": { "type": "string", "maxLength": 16 },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["id", "name", "anchor", "isActive", "createdAt"]
    },
    "Habit": {
      "title": "Habit",
      "description": "Non-sensitive daily or weekly habit item (medication habits are strictly on-device-only)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 160 },
        "icon": { "type": "string", "maxLength": 32 },
        "notes": { "type": "string", "maxLength": 1000 },
        "frequency": { "type": "string", "enum": ["daily", "weekdays", "weekends"] },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["id", "name", "frequency", "isActive", "createdAt"]
    },
    "HabitCheckIn": {
      "title": "HabitCheckIn",
      "description": "Daily habit completion record for non-sensitive habits",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "habitId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 16 },
        "completed": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["id", "habitId", "date", "completed", "createdAt"]
    },
    "Note": {
      "title": "Note",
      "description": "Scratchpad note optionally linked to a task",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "body": { "type": "string", "maxLength": 10000 },
        "pinned": { "type": "boolean" },
        "linkedTaskId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["id", "body", "pinned", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile document"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "User tasks subcollection"
    },
    "/users/{userId}/routines/{routineId}": {
      "schema": { "$ref": "#/entities/Routine" },
      "description": "User routines subcollection"
    },
    "/users/{userId}/habits/{habitId}": {
      "schema": { "$ref": "#/entities/Habit" },
      "description": "User non-sensitive habits subcollection"
    },
    "/users/{userId}/habit_checkins/{checkInId}": {
      "schema": { "$ref": "#/entities/HabitCheckIn" },
      "description": "User habit check-ins subcollection"
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": { "$ref": "#/entities/Note" },
      "description": "User notes subcollection"
    }
  }
}
